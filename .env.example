# ==============================================================================
# RepoSage Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, test)
APP_ENV=development
APP_NAME=RepoSage
APP_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
DEBUG=true

# Database Configuration (PostgreSQL + pgvector)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reposage
TEST_DATABASE_URL=sqlite:///./test_reposage.db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reposage_code_chunks

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers Configuration
# Supported providers: openai, gemini, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2500

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Embedding Configuration
# Supported providers: openai, sentence-transformers, mock
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# Repository Ingestion Constraints & Security Limits
MAX_REPOSITORY_SIZE_MB=100
MAX_FILE_SIZE_MB=5
MAX_ARCHIVE_FILES=1000
MAX_CHUNK_SIZE=1200
CHUNK_OVERLAP=150
REPO_STORAGE_PATH=./data/repositories

# Retrieval & Search Settings
TOP_K_RETRIEVAL=10
SIMILARITY_THRESHOLD=0.3
RERANKING_ENABLED=false
HYBRID_SEARCH_ALPHA=0.65

# CORS and Network Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Sandbox & Execution Safety
SANDBOX_EXECUTION_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=15
